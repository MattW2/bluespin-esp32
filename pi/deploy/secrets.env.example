# Copy this file to pi/deploy/secrets.env and fill in your Raspberry Pi 3B details.
# pi/deploy/secrets.env is gitignored and will NEVER be committed.

PI_HOST=192.168.1.xxx
PI_PORT=22
PI_USER=pi
# Use either PI_SSH_KEY (recommended) or PI_PASSWORD for SSH/SCP
PI_SSH_KEY=
PI_PASSWORD=

# BlueSpin Pi runtime settings
BLUESPIN_NAME=BlueSpin Kitchen
BLUESPIN_WEB_PORT=8080
BLUESPIN_SENDSPIN_PORT=8928
BLUESPIN_CODEC=opus
BLUESPIN_OLED_ENABLED=true
BLUESPIN_UNPAIRED_ACCESS=false
