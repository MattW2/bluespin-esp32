# Copy this file to `secrets.yaml` and fill in your values before compiling/flashing.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Generate a 32-byte base64 key at https://esphome.io/components/api.html#configuration-variables
# or run: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA="

ota_password: "change-me-ota-password"
ap_fallback_password: "change-me-ap-password"
